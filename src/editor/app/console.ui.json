{
  "root": "shell",
  "texts": {},
  "templates": {
    "shell": {
      "type": "fieldset",
      "testId": "fwa-console",
      "attrs": {
        "data-fwa-workbench": true
      },
      "children": [
        {
          "type": "toolbar",
          "children": [
            {
              "type": "field",
              "ref": "goalSelect",
              "field": {
                "label": "当前任务",
                "path": "goalSelect",
                "type": "select"
              },
              "attrs": {
                "aria-label": "当前目标"
              }
            },
            {
              "type": "badge",
              "ref": "mode",
              "text": "只读预览",
              "hidden": true,
              "attrs": {
                "title": "当前工作台只查看状态和结果，不能执行或修改任务。"
              }
            },
            {
              "type": "button",
              "ref": "refresh",
              "testId": "fwa-refresh",
              "text": "刷新",
              "on": {
                "click": "refresh"
              }
            }
          ]
        },
        {
          "type": "details",
          "ref": "requestDisclosure",
          "children": [
            {
              "type": "summary",
              "ref": "requestSummary",
              "text": "新建任务"
            },
            {
              "type": "slot",
              "ref": "request",
              "testId": "fwa-requirement"
            }
          ]
        },
        {
          "type": "slot",
          "ref": "libraryPreview",
          "hidden": true,
          "testId": "fwa-library-preview"
        },
        {
          "type": "text",
          "ref": "message",
          "testId": "fwa-status",
          "attrs": {
            "role": "status"
          }
        },
        {
          "type": "toolbar",
          "children": [
            {
              "type": "text",
              "ref": "progress",
              "testId": "fwa-progress-summary"
            },
            {
              "type": "button",
              "ref": "work",
              "text": "继续",
              "tone": "primary",
              "attrs": {
                "disabled": true
              },
              "on": {
                "click": "work"
              }
            }
          ]
        },
        {
          "type": "text",
          "ref": "workReason",
          "tone": "muted"
        },
        {
          "type": "columns",
          "columns": 2,
          "attrs": {
            "data-fwa-layout": "workspace"
          },
          "children": [
            {
              "type": "card",
              "attrs": {
                "data-fwa-pane": "graph"
              },
              "children": [
                {
                  "type": "toolbar",
                  "children": [
                    {
                      "type": "heading",
                      "text": "任务图"
                    },
                    {
                      "type": "field",
                      "field": {
                        "type": "text",
                        "path": "search",
                        "label": false
                      },
                      "attrs": {
                        "aria-label": "定位任务",
                        "placeholder": "输入名称，按 Enter 定位"
                      },
                      "on": {
                        "keydown": "locate"
                      }
                    },
                    {
                      "type": "button",
                      "ref": "graphScope",
                      "testId": "fwa-graph-scope",
                      "text": "查看全图",
                      "on": {
                        "click": "graphScope"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "ref": "graphScopeNote",
                  "testId": "fwa-graph-scope-note",
                  "tone": "muted"
                },
                {
                  "type": "slot",
                  "ref": "graphHost",
                  "testId": "fwa-dag",
                  "attrs": {
                    "data-fwa-graph": true
                  }
                }
              ]
            },
            {
              "type": "card",
              "ref": "detail",
              "testId": "fwa-inspector",
              "attrs": {
                "aria-label": "选中节点详情",
                "data-fwa-pane": "inspector"
              }
            }
          ]
        }
      ]
    },
    "inspector": {
      "type": "stack",
      "children": [
        {
          "type": "button",
          "ref": "back",
          "text": "← 返回任务节点",
          "on": {
            "click": "back"
          }
        },
        {
          "type": "slot",
          "ref": "facts"
        },
        {
          "type": "slot",
          "ref": "feedback"
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "对象链接"
            },
            {
              "type": "slot",
              "ref": "links"
            }
          ]
        }
      ]
    },
    "emptySelection": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": "从需求生成任务图"
        },
        {
          "type": "text",
          "text": "输入需求后生成任务图；选择一个节点，查看目标、完成条件和前置原因。"
        }
      ]
    },
    "recordTitle": {
      "type": "heading",
      "text": {
        "$path": "title"
      }
    },
    "notice": {
      "type": "text",
      "text": {
        "$path": "text"
      },
      "tone": {
        "$path": "tone"
      }
    },
    "empty": {
      "type": "text",
      "text": "暂无记录。"
    },
    "goal": {
      "type": "card",
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "title"
          }
        },
        {
          "type": "badge",
          "text": {
            "$path": "status"
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "request"
          }
        },
        {
          "type": "slot",
          "ref": "record"
        }
      ]
    }
  }
}
