{
  "texts": {
    "importReading": "正在导入…",
    "dropDescription": "单文件 ≤{maxFileMiB} MiB，总量 ≤{maxUploadMiB} MiB。导入副本，原文件保持不变。",
    "selectLibrary": "规划使用当前版本：{label}",
    "stopReason": "停止原因：{stopReason}",
    "selectLibraries": "使用的资料（最多 {maxReferenceLibraries} 个）",
    "groupPhase": "当前状态：{phase}。此分组汇总下方任务。",
    "imported": "已导入",
    "importUnconfirmed": "导入结果未确认，请刷新核对。",
    "planned": "已提交",
    "permissionSaved": "权限已保存",
    "accessRead": "只读",
    "accessWrite": "可写副本",
    "accessDeny": "禁止读取",
    "jobRunning": "运行中",
    "jobFailed": "失败",
    "jobInterrupted": "已中断 / 结果未确认",
    "jobSucceeded": "已返回",
    "jobQuestions": "需要补充信息",
    "zeroChange": "未产生文件改动，需核对执行日志。",
    "zeroRun": "零改动 Run：{runId} · ChangeSet：{changeSetId}",
    "permissionExplicit": "此路径显式设置",
    "permissionInherited": "继承自 {source}",
    "defaultRead": "默认只读",
    "permissionStatus": "有效权限：{access}；{source}",
    "versionCurrent": "当前 · {version}",
    "versionHistory": "历史 · {version}",
    "mediaError": "无法加载此媒体；文件可能不受浏览器支持。",
    "mediaUnsupported": "此类型或大小暂不支持正文预览。导入副本和版本仍已保留。",
    "readContent": "正在校验并读取副本…",
    "readTree": "读取目录树…",
    "feedbackSaved": "补充要求已保存，尚未调整任务图。",
    "revisionSaved": "正在调整任务图。",
    "revisionNeedsFeedback": "需要当前计划版本和 1–{maxRevisionFeedback} 条待处理反馈。请刷新核对。",
    "requestFailed": "请求失败：{error}",
    "historicalNode": "这是历史任务，请选择当前版本调整。",
    "activeOperation": "当前操作未结束，可先暂存要求。",
    "feedbackPending": "待处理 · 尚未生效",
    "feedbackState": "状态：{status} · {revision}",
    "seeRevision": "请查看修订记录"
  },
  "fields": {
    "request": {
      "schemaPath": "commands.request",
      "type": "textarea",
      "label": "新任务需求",
      "rows": 2
    },
    "feedback": {
      "schemaPath": "commands.feedback",
      "type": "textarea",
      "label": "补充要求",
      "rows": 3
    },
    "permission": {
      "schemaPath": "commands.permission",
      "label": "资料权限",
      "optionLabels": {
        "read": "只读",
        "write": "允许修改副本",
        "deny": "禁止读取",
        "": "继承父级"
      },
      "clear": false
    },
    "selected": {
      "type": "checkbox",
      "label": false
    },
    "version": {
      "type": "select",
      "label": "预览资料版本",
      "options": []
    },
    "files": {
      "type": "file",
      "label": "选择文件",
      "multiple": true
    },
    "folder": {
      "type": "file",
      "label": "选择文件夹",
      "multiple": true
    },
    "zip": {
      "type": "file",
      "label": "选择 ZIP",
      "accept": ".zip"
    }
  },
  "templates": {
    "intake": {
      "type": "stack",
      "testId": "fwa-workflow-intake",
      "attrs": {
        "data-fwa-intake": ""
      },
      "children": [
        {
          "type": "form",
          "ref": "planForm",
          "testId": "fwa-planning-form",
          "on": {
            "submit": "plan"
          },
          "children": [
            {
              "type": "field",
              "field": "request",
              "ref": "request",
              "value": {
                "$path": "request"
              },
              "attrs": {
                "aria-label": "需求描述",
                "placeholder": "描述新任务希望达成的结果，以及必须保留的限制。"
              },
              "on": {
                "input": "requestChanged"
              }
            },
            {
              "type": "button",
              "ref": "planButton",
              "text": {
                "$path": "planLabel"
              },
              "tone": "primary",
              "attrs": {
                "type": "submit",
                "disabled": {
                  "$path": "planDisabled"
                }
              }
            },
            {
              "type": "details",
              "ref": "references",
              "attrs": {
                "open": {
                  "$path": "referencesOpen"
                }
              },
              "children": [
                {
                  "type": "summary",
                  "text": "添加参考资料（可选）"
                },
                {
                  "type": "card",
                  "ref": "drop",
                  "testId": "fwa-reference-drop",
                  "tone": "info",
                  "children": [
                    {
                      "type": "heading",
                      "text": "添加文件、文件夹或 ZIP"
                    },
                    {
                      "type": "text",
                      "tone": "muted",
                      "text": {
                        "$text": "dropDescription"
                      }
                    },
                    {
                      "type": "row",
                      "children": [
                        {
                          "type": "field",
                          "field": "files",
                          "ref": "files",
                          "attrs": {
                            "aria-label": "选择文件",
                            "disabled": {
                              "$path": "uploadDisabled"
                            }
                          },
                          "on": {
                            "change": "importFiles"
                          }
                        },
                        {
                          "type": "field",
                          "field": "folder",
                          "ref": "folder",
                          "attrs": {
                            "aria-label": "选择文件夹",
                            "webkitdirectory": true,
                            "directory": true,
                            "disabled": {
                              "$path": "uploadDisabled"
                            }
                          },
                          "on": {
                            "change": "importFiles"
                          }
                        },
                        {
                          "type": "field",
                          "field": "zip",
                          "ref": "zip",
                          "attrs": {
                            "aria-label": "选择 ZIP",
                            "disabled": {
                              "$path": "uploadDisabled"
                            }
                          },
                          "on": {
                            "change": "importFiles"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": {
                    "$text": "selectLibraries"
                  }
                },
                {
                  "type": "stack",
                  "ref": "libraries",
                  "testId": "fwa-library-list"
                }
              ]
            },
            {
              "type": "text",
              "text": {
                "$path": "planningBlocker"
              },
              "tone": "warning",
              "visible": {
                "$path": "planningBlocker"
              }
            },
            {
              "type": "details",
              "visible": {
                "$path": "needsReviewSetup"
              },
              "children": [
                {
                  "type": "summary",
                  "text": "执行条件未配置"
                },
                {
                  "type": "text",
                  "text": "未配置项目检查，暂不能验证、采用或撤销修改。",
                  "tone": "warning"
                },
                {
                  "type": "details",
                  "children": [
                    {
                      "type": "summary",
                      "text": "配置方法"
                    },
                    {
                      "type": "text",
                      "text": "启动时添加 --review-config <配置.json>，指定验收与回归检查。"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "ref": "notice",
          "text": {
            "$path": "message"
          },
          "tone": {
            "$if": [
              {
                "$path": "error"
              },
              "danger",
              "muted"
            ]
          },
          "attrs": {
            "role": "status"
          },
          "visible": {
            "$path": "message"
          }
        },
        {
          "type": "details",
          "ref": "recent",
          "attrs": {
            "open": {
              "$path": "recentOpen"
            }
          },
          "children": [
            {
              "type": "summary",
              "text": "最近请求"
            },
            {
              "type": "stack",
              "ref": "jobs",
              "testId": "fwa-workflow-jobs"
            }
          ],
          "visible": {
            "$path": "hasJobs"
          }
        }
      ]
    },
    "libraries": {
      "type": "list",
      "items": {
        "$path": "libraries"
      },
      "template": "library",
      "emptyTemplate": "noLibraries"
    },
    "noLibraries": {
      "type": "text",
      "tone": "muted",
      "text": "暂无参考资料。拖入文件夹，或先描述需求。"
    },
    "library": {
      "type": "row",
      "children": [
        {
          "type": "field",
          "field": "selected",
          "value": {
            "$path": "selected"
          },
          "attrs": {
            "aria-label": {
              "$text": "selectLibrary"
            }
          },
          "on": {
            "change": "librarySelected"
          }
        },
        {
          "type": "button",
          "text": {
            "$path": "label"
          },
          "attrs": {
            "data-library-id": {
              "$path": "id"
            }
          },
          "on": {
            "click": "browseLibrary"
          }
        },
        {
          "type": "badge",
          "tone": "muted",
          "text": {
            "$path": "shortVersion"
          }
        }
      ]
    },
    "jobs": {
      "type": "stack",
      "children": [
        {
          "type": "list",
          "items": {
            "$path": "jobs"
          },
          "template": "job",
          "emptyTemplate": "noJobs"
        }
      ]
    },
    "noJobs": {
      "type": "text",
      "tone": "muted",
      "text": "尚无请求。"
    },
    "job": {
      "type": "card",
      "attrs": {
        "data-job-id": {
          "$path": "id"
        }
      },
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "heading"
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "errorText"
          },
          "tone": "danger",
          "visible": {
            "$path": "errorText"
          }
        },
        {
          "type": "list",
          "items": {
            "$path": "questions"
          },
          "template": "question"
        },
        {
          "type": "text",
          "text": {
            "$path": "stopLabel"
          },
          "tone": "info",
          "visible": {
            "$path": "stopReason"
          }
        },
        {
          "type": "text",
          "text": {
            "$text": "zeroChange"
          },
          "tone": "warning",
          "visible": {
            "$path": "zeroChanges"
          }
        },
        {
          "type": "list",
          "items": {
            "$path": "zeroRuns"
          },
          "template": "zeroRun"
        },
        {
          "type": "button",
          "text": "查看计划",
          "visible": {
            "$path": "goalId"
          },
          "on": {
            "click": "openGoal"
          }
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "作业原始记录"
            },
            {
              "type": "pre",
              "preset": "scroll",
              "text": {
                "$path": "record"
              }
            }
          ]
        }
      ]
    },
    "question": {
      "type": "text",
      "text": {
        "$path": "$item"
      },
      "tone": "warning"
    },
    "zeroRun": {
      "type": "text",
      "text": {
        "$text": "zeroRun"
      },
      "tone": "muted"
    },
    "libraryEmpty": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": "参考资料与权限"
        },
        {
          "type": "text",
          "tone": "muted",
          "text": "选择一个资料库浏览目录、版本和正文。导入资料不会自动授予工程写入权。"
        }
      ]
    },
    "libraryDetail": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "label"
          }
        },
        {
          "type": "field",
          "field": "version",
          "ref": "version",
          "value": {
            "$path": "versionId"
          },
          "attrs": {
            "aria-label": "预览资料版本"
          },
          "on": {
            "change": "versionChanged"
          }
        },
        {
          "type": "text",
          "tone": "info",
          "text": "版本切换仅用于预览；规划勾选始终绑定资料库当前版本。历史内容不会被覆盖。"
        },
        {
          "type": "stack",
          "ref": "tree",
          "preset": "scroll",
          "testId": "fwa-library-tree"
        },
        {
          "type": "stack",
          "ref": "content"
        }
      ]
    },
    "entry": {
      "type": "row",
      "children": [
        {
          "type": "button",
          "text": {
            "$path": "entryLabel"
          },
          "attrs": {
            "data-library-path": {
              "$path": "entry.path"
            }
          },
          "on": {
            "click": "previewEntry"
          }
        },
        {
          "type": "badge",
          "text": {
            "$path": "accessLabel"
          },
          "tone": "muted"
        }
      ]
    },
    "folder": {
      "type": "details",
      "ref": "folder",
      "attrs": {
        "open": {
          "$path": "open"
        }
      },
      "children": [
        {
          "type": "summary",
          "children": [
            {
              "type": "template",
              "template": "entry"
            }
          ]
        },
        {
          "type": "stack",
          "ref": "children",
          "preset": "compact"
        }
      ]
    },
    "preview": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": {
            "$if": [
              {
                "$path": "path"
              },
              {
                "$path": "path"
              },
              "资料库根目录"
            ]
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "permissionStatus"
          },
          "tone": "muted"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "field",
              "field": "permission",
              "ref": "permission",
              "value": {
                "$path": "permission"
              },
              "attrs": {
                "aria-label": "资料权限",
                "disabled": {
                  "$path": "permissionDisabled"
                }
              }
            },
            {
              "type": "button",
              "ref": "permissionApply",
              "text": "应用权限",
              "attrs": {
                "disabled": {
                  "$path": "permissionDisabled"
                }
              },
              "on": {
                "click": "applyPermission"
              }
            }
          ]
        },
        {
          "type": "text",
          "tone": "muted",
          "text": "这些权限只作用于资料副本；不授予原目录、project/ 或 fw/ 的写入权。"
        },
        {
          "type": "text",
          "tone": "muted",
          "text": "选择下级文件查看正文。导入记录中的空文件夹已保留在工程资料库中。",
          "visible": {
            "$not": {
              "$path": "isFile"
            }
          }
        },
        {
          "type": "text",
          "tone": "warning",
          "text": "此文件禁止读取，未请求其内容。",
          "visible": {
            "$and": [
              {
                "$path": "isFile"
              },
              {
                "$path": "denied"
              }
            ]
          }
        },
        {
          "type": "stack",
          "ref": "preview",
          "testId": "fwa-library-preview",
          "visible": {
            "$and": [
              {
                "$path": "isFile"
              },
              {
                "$not": {
                  "$path": "denied"
                }
              }
            ]
          }
        }
      ]
    },
    "content": {
      "type": "stack",
      "children": [
        {
          "type": "text",
          "text": {
            "$path": "identity"
          },
          "tone": "muted"
        },
        {
          "type": "slot",
          "ref": "body",
          "preset": "preview"
        },
        {
          "type": "link",
          "text": "打开 PDF 副本",
          "attrs": {
            "href": {
              "$path": "raw"
            },
            "target": "_blank",
            "rel": "noopener noreferrer"
          },
          "visible": {
            "$path": "pdf"
          }
        }
      ]
    },
    "message": {
      "type": "text",
      "text": {
        "$path": "message"
      },
      "tone": {
        "$path": "tone",
        "default": "muted"
      }
    },
    "textContent": {
      "type": "pre",
      "preset": "scroll",
      "text": {
        "$path": "text"
      }
    },
    "feedback": {
      "type": "details",
      "testId": "fwa-node-feedback",
      "attrs": {
        "data-node-id": {
          "$path": "nodeId"
        }
      },
      "children": [
        {
          "type": "summary",
          "text": { "$path": "summary", "default": "调整此任务" }
        },
        {
          "type": "field",
          "field": "feedback",
          "ref": "feedback",
          "value": {
            "$path": "draft"
          },
          "attrs": {
            "aria-label": "节点修改建议"
          },
          "on": {
            "input": "feedbackChanged"
          }
        },
        {
          "type": "toolbar",
          "children": [
            {
              "type": "button",
              "ref": "submit",
              "text": "暂存补充要求",
              "visible": { "$path": "submitVisible" },
              "attrs": {
                "disabled": {
                  "$path": "submitDisabled",
                  "default": true
                }
              },
              "on": {
                "click": "submitFeedback"
              }
            },
            {
              "type": "button",
              "ref": "revise",
              "text": "按补充要求调整图",
              "attrs": {
                "disabled": {
                  "$path": "reviseDisabled",
                  "default": true
                }
              },
              "on": {
                "click": "revise"
              },
              "tone": "primary"
            }
          ]
        },
        {
          "type": "text",
          "ref": "result",
          "text": {
            "$path": "result"
          },
          "tone": "muted"
        },
        {
          "type": "stack",
          "ref": "feedbackList"
        }
      ]
    },
    "feedbackList": {
      "type": "list",
      "items": {
        "$path": "items"
      },
      "template": "feedbackItem"
    },
    "feedbackItem": {
      "type": "card",
      "preset": "compact",
      "children": [
        {
          "type": "badge",
          "text": {
            "$path": "statusLabel"
          },
          "tone": "muted"
        },
        {
          "type": "text",
          "text": {
            "$path": "text"
          }
        }
      ]
    },
    "groupMissing": {
      "type": "text",
      "tone": "muted",
      "text": "当前计划中没有此分组。"
    },
    "group": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "title"
          }
        },
        {
          "type": "text",
          "text": {
            "$text": "groupPhase"
          },
          "tone": "info"
        },
        {
          "type": "list",
          "items": {
            "$path": "leaves"
          },
          "template": "groupLeaf"
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "分组事实与子节点"
            },
            {
              "type": "pre",
              "preset": "scroll",
              "text": {
                "$path": "record"
              }
            }
          ]
        }
      ]
    },
    "groupLeaf": {
      "type": "button",
      "text": {
        "$path": "label"
      },
      "on": {
        "click": "selectNode"
      }
    }
  }
}
